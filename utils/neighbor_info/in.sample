# Usage:
# lmp -i in.ni \
#   -v pfile ${POTENTIAL_FILE}

# Pure Ni Liquid bulk

units           metal
boundary        p p p

atom_style      atomic

lattice	        fcc 3.52
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box

pair_style      eam/alloy
pair_coeff      * * ${pfile} Ni Al

write_data      data.0K


